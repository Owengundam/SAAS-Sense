# Reference only. Generate the production file with the current Shopify CLI and
# replace placeholders after the owner connects the app and development store.

name = "SupplierSignal"
client_id = "REPLACE_FROM_SHOPIFY"
application_url = "https://REPLACE_WITH_DEPLOYED_HOST"
embedded = true

[access_scopes]
scopes = "read_products"

[auth]
redirect_urls = [ "https://REPLACE_WITH_DEPLOYED_HOST/auth/callback" ]

[[webhooks.subscriptions]]
topics = [ "app/uninstalled", "customers/data_request", "customers/redact", "shop/redact" ]
uri = "/webhooks/shopify"

[build]
automatically_update_urls_on_dev = true
